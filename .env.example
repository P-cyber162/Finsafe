# Copy this file to `.env` and replace the placeholders with real values.

# Environment: dev | test | prod
NODE_ENV="dev"

# Server port
PORT="3000"

# PostgreSQL connection string (Prisma requires >= 15 with driver adapters)
DATABASE_URL="postgresql://user:password@localhost:5432/finsafe"

# Redis for session support
REDIS_URL="redis://localhost:6379"

# Allowed frontend origin. Must start with https://
FRONTEND_URL="https://localhost:5173"

# JWT signing secrets (must be at least 32 characters)
ACCESS_TOKEN_SECRET="please-generate-a-32-character-secret"
REFRESH_TOKEN_SECRET="please-generate-a-different-32-character-secret"

# Token lifetimes (jose format)
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Bcrypt cost factor (10 - 20)
BCRYPT_ROUNDS=12

# Default user balance (users are seeded with this on registration)
USER_BALANCE="1000"